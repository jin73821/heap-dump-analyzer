# 로그 파일
*.log
logs/
*.out

# 임시 파일
*.tmp
*.temp
*.swp
*~

# 빌드 결과물
target/
build/
dist/
*.class
*.jar
*.war

# IDE 설정
.idea/
.vscode/
*.iml
.project
.classpath

# Claude Code 로컬 설정 — 승인한 셸 명령이 인자까지 그대로 기록된다.
# 명령 인자에 자격증명이 섞이는 경우가 있고 이 저장소는 public 이므로 커밋 금지.
.claude/

# 환경 설정 파일 (민감 정보 포함 가능)
.env
env.local.sh
*.properties
config/local.conf

# 데이터베이스 파일
*.db
*.sqlite

# 운영 데이터 백업 (힙 분석 상세 / DB 행 덤프 — 저장소에 올리지 않음)
backup/

# OS 생성 파일
.DS_Store
Thumbs.db

.bashrc
.genspark_llm.yaml
.git-credentials

# 사내 CA 인증서 / truststore (보안)
certs/
*.jks
*.p12
*.pem
*.crt
*.cer
*.key
